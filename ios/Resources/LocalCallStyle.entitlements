<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Time Sensitive Notifications capability. Add it in Xcode under
	  Signing & Capabilities so the provisioning profile carries it, otherwise
	  interruptionLevel = .timeSensitive is silently downgraded to .active.
	-->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>
