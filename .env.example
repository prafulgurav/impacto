# Market data: fixture (offline, deterministic, default) | yfinance
GP_MARKET_PROVIDER=fixture

# Global macro series (free key: https://fred.stlouisfed.org/docs/api/api_key.html)
GP_FRED_API_KEY=

# Event/news ingestion
GP_GDELT_ENABLED=true
GP_NEWS_RSS_FEEDS=https://www.moneycontrol.com/rss/marketreports.xml,https://economictimes.indiatimes.com/markets/rssfeeds/1977021501.cms

# Narration layer. none = fully deterministic, grounded output (default, and how CI runs)
GP_LLM_PROVIDER=none
GP_LLM_MODEL=claude-opus-4-5
GP_ANTHROPIC_API_KEY=

# Event study
GP_ESTIMATION_WINDOW=120
GP_ESTIMATION_GAP=10
GP_MIN_ESTIMATION_OBS=60

# Compliance guardrail. Do not disable for a user-facing deployment in India.
GP_COMPLIANCE_MODE=true
GP_JURISDICTION=IN
