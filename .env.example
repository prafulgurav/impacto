# Impacto configuration.
# Every variable uses the IMPACTO_ prefix. The legacy GP_ prefix from the
# globalpulse-india engine is still honoured as a fallback.

# Market data: fixture (offline, deterministic, default) | yfinance
IMPACTO_MARKET_PROVIDER=fixture

# Global macro series (free key: https://fred.stlouisfed.org/docs/api/api_key.html)
IMPACTO_FRED_API_KEY=

# Event/news ingestion
IMPACTO_GDELT_ENABLED=true
IMPACTO_NEWS_RSS_FEEDS=https://www.moneycontrol.com/rss/marketreports.xml,https://economictimes.indiatimes.com/markets/rssfeeds/1977021501.cms

# ---------------------------------------------------------------- narration
# none     fully deterministic grounded output (default, and how CI runs)
# anthropic  narrate with Claude          (pip install 'impacto[llm]')
# gemini     narrate with Gemini          (pip install 'impacto[gemini]')
# auto       pick whichever key is set, Anthropic first
#
# The LLM never introduces a number. It rewrites an answer the engine already
# composed, and its output is re-checked by the compliance guardrail before it
# can reach a user. Switching providers cannot change what the product claims.
IMPACTO_LLM_PROVIDER=none

# Per-provider keys and models. IMPACTO_LLM_MODEL overrides whichever provider
# is active; the per-provider vars win over it.
IMPACTO_ANTHROPIC_API_KEY=
IMPACTO_ANTHROPIC_MODEL=claude-opus-5
IMPACTO_GEMINI_API_KEY=
IMPACTO_GEMINI_MODEL=gemini-2.5-flash
IMPACTO_LLM_MAX_TOKENS=1200
IMPACTO_LLM_TIMEOUT_SECONDS=30

# Event study
IMPACTO_ESTIMATION_WINDOW=120
IMPACTO_ESTIMATION_GAP=10
IMPACTO_MIN_ESTIMATION_OBS=60

# Compliance guardrail. Do not disable for a user-facing deployment in India.
IMPACTO_COMPLIANCE_MODE=true
IMPACTO_JURISDICTION=IN
